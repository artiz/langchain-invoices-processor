        <mxCell id="e3" value="raw RFC 822" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;" edge="1" parent="1" source="poller" target="parser">
          <mxGeometry relative="1" as="geometry" />
