# --- LLM
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4-mini
# Set to empty for non-reasoning models (e.g. gpt-4.1-mini)
OPENAI_REASONING_EFFORT=low

# --- Gmail via KateChat MCP (https://github.com/artiz/kate-chat)
GMAIL_MCP_URL=https://katechat.tech/mcp/gmail
# Google OAuth client (Desktop app, or Web app with http://localhost:8765/callback as redirect URI)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: skip `invoice-agent auth` by providing a refresh token directly
GOOGLE_REFRESH_TOKEN=
GOOGLE_OAUTH_PORT=8765
GMAIL_LOOKBACK_DAYS=7
# Optional: override the Gmail prefilter query ({days} is substituted)
# GMAIL_QUERY=in:inbox newer_than:{days}d (rechnung OR invoice OR iban)
POLL_INTERVAL_SECONDS=300
# Your own addresses (comma-separated): invoices you forward from them are judged by the original sender
OWNER_EMAILS=

# --- Telegram
TELEGRAM_BOT_TOKEN=
# Optional: otherwise send /start to the bot and the chat is linked automatically
TELEGRAM_CHAT_ID=
REMIND_AFTER_HOURS=24
TIMEZONE=Europe/Vienna

# --- Optional Langfuse tracing (uv sync --extra langfuse)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
